{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [{ "source": "/comparison", "destination": "/compare", "permanent": true }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
